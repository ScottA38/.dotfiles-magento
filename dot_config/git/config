[alias]
	amen = "commit --amend --no-edit"
	remv = "remote -v"
	s = "status"
  cma = "commit --amend"
  stgdiff = "diff --cached"
  stashl = "stash list"
  diffstat = "diff --stat"

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

